{
  "name": "smartresponsor/notifying",
  "description": "Smart Responsor Notifying platform component: notification center, inbox, preferences, subscriptions, and delivery planning.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.3",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/yaml": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/phpunit-bridge": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Notifying\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Notifying\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
