{
  "name": "smartresponsor/notifying",
  "description": "Smart Responsor Notifying platform component: notification center, inbox, preferences, subscriptions, and delivery planning.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "ext-json": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/asset": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "tabling/table": "dev-master",
    "twig/twig": "^3.27",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.17",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/phpunit-bridge": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Notifying\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Notifying\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox tests",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "lint:container": "php bin/console lint:container",
    "lint:yaml": "php bin/console lint:yaml config --parse-tags",
    "schema:reset:test": "@php -r \"if (is_file('var/notifying_test.sqlite')) { unlink('var/notifying_test.sqlite'); }\"",
    "schema:migrate:test": "@php bin/console doctrine:migrations:migrate --env=test --no-interaction",
    "schema:validate": "php bin/console doctrine:schema:validate --env=test",
    "schema:diff": "php bin/console doctrine:schema:update --dump-sql --env=test",
    "schema:parity": [
      "@schema:reset:test",
      "@schema:migrate:test",
      "@schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@lint:container",
      "@lint:yaml",
      "@schema:parity"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "require": "^8.1"
    }
  }
}
